#!/usr/bin/env bash
#
# Copyright © 2026 OpenCHAMI a Series of LF Projects, LLC
#
# SPDX-License-Identifier: MIT
#
# generate-user-service scaffolds and generates the storage-annotations
# user-service end to end, following:
#   - work/ochami/inventory-with-db.md       (current command list)
#   - fabrica/examples/12-storage-annotations/README.md  (Steps 1-4)
#
# It performs:
#   1. fabrica init           (Step 1)
#   2. add a local fabrica replace directive (optional)
#   3. fab-init               (Step 2 `fabrica add resource` + Step 3 struct merge)
#   4. fabrica generate       (Step 4)
#   5. go mod tidy -e / go generate ./... / go mod tidy / go build ./...
#
# The `migrate` step from the README is intentionally omitted: that command no
# longer exists; `go generate ./...` produces the Ent code instead.
#
# Every command is printed before it runs. The script stops on the first
# failure.

set -euo pipefail

# --- resolve repository layout ----------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ANNOTATIONS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ROOT_DIR="$(cd "$ANNOTATIONS_DIR/.." && pwd)"

FAB_INIT_DIR="$ANNOTATIONS_DIR/fab-init"
STRUCTS_DIR="${STRUCTS_DIR:-$ANNOTATIONS_DIR/user-service-structs}"
FABRICA_DIR="${FABRICA_DIR:-$ROOT_DIR/fabrica}"

# --- configuration (defaults; override via environment or CLI flags) --------

SERVICE_NAME="${SERVICE_NAME:-user-service}"
MODULE="${MODULE:-}"
GROUP="${GROUP:-storage-annotations.openchami.org}"
DB="${DB:-sqlite}"
AUTH="${AUTH:-false}"
OUT_DIR="${OUT_DIR:-$ANNOTATIONS_DIR/build}"

# --- command-line options ---------------------------------------------------

usage() {
	cat <<EOF
Usage: $(basename "$0") [options]

Scaffolds and generates the storage-annotations user-service.

Options (same form as 'fabrica init'):
  --auth                 Enable authentication with TokenSmith
  --db <driver>          Ent database driver: sqlite, postgres, or mysql (default: $DB)
  --module <path>        Go module path (default: github.com/openchami/<name>)

Additional options:
  --name <name>          Project name, e.g. user-service, user-service-postgres,
                         user-service-sqlite (default: $SERVICE_NAME)
  --working-dir <dir>    Directory in which to create the project
                         (default: $OUT_DIR)
  -h, --help             Show this help
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	--auth) AUTH=true; shift ;;
	--auth=*) AUTH="${1#*=}"; shift ;;
	--db) [[ $# -ge 2 ]] || { echo "error: --db requires a value" >&2; exit 2; }; DB="$2"; shift 2 ;;
	--db=*) DB="${1#*=}"; shift ;;
	--module) [[ $# -ge 2 ]] || { echo "error: --module requires a value" >&2; exit 2; }; MODULE="$2"; shift 2 ;;
	--module=*) MODULE="${1#*=}"; shift ;;
	--name) [[ $# -ge 2 ]] || { echo "error: --name requires a value" >&2; exit 2; }; SERVICE_NAME="$2"; shift 2 ;;
	--name=*) SERVICE_NAME="${1#*=}"; shift ;;
	--working-dir) [[ $# -ge 2 ]] || { echo "error: --working-dir requires a value" >&2; exit 2; }; OUT_DIR="$2"; shift 2 ;;
	--working-dir=*) OUT_DIR="${1#*=}"; shift ;;
	-h | --help) usage; exit 0 ;;
	*) echo "error: unknown option: $1" >&2; usage >&2; exit 2 ;;
	esac
done

# Derive the module path from the project name unless one was provided.
: "${MODULE:=github.com/openchami/${SERVICE_NAME}}"

# Absolutize the working directory so it survives being passed to native tools.
case "$OUT_DIR" in
/* | [A-Za-z]:*) ;;
*) OUT_DIR="$(pwd)/$OUT_DIR" ;;
esac

SERVICE_DIR="$OUT_DIR/$SERVICE_NAME"

# Path to the fabrica binary; prefer the fabrica on PATH, fall back to a local build.
if [[ -z "${FABRICA_BIN:-}" ]]; then
	if command -v fabrica >/dev/null 2>&1; then
		FABRICA_BIN="fabrica"
	elif [[ -x "$FABRICA_DIR/bin/fabrica.exe" ]]; then
		FABRICA_BIN="$FABRICA_DIR/bin/fabrica.exe"
	elif [[ -x "$FABRICA_DIR/bin/fabrica" ]]; then
		FABRICA_BIN="$FABRICA_DIR/bin/fabrica"
	else
		FABRICA_BIN="fabrica"
	fi
fi

# Local fabrica checkout to pin via a go.mod replace directive.
#
# By default this is derived from the fabrica binary in use: a replace directive
# is only added when that binary lives in a bin/ directory inside a local git
# checkout of the fabrica repo. Set LOCAL_FABRICA explicitly (including to the
# empty string) to override the detection.

# detect_local_fabrica_repo prints the path to a local fabrica git checkout when
# the given fabrica binary lives in its bin/ directory; otherwise prints nothing.
detect_local_fabrica_repo() {
	local bin="$1" path dir repo

	# Resolve a bare command name (e.g. "fabrica") via PATH.
	if [[ "$bin" == */* ]]; then
		path="$bin"
	else
		path="$(command -v "$bin" 2>/dev/null || true)"
	fi
	[[ -n "$path" ]] || return 0

	dir="$(cd "$(dirname "$path")" 2>/dev/null && pwd)" || return 0
	[[ "$(basename "$dir")" == "bin" ]] || return 0

	repo="$(dirname "$dir")"
	[[ -e "$repo/.git" ]] || return 0                                  # a git repo
	[[ -f "$repo/go.mod" ]] || return 0
	# Match the module line, tolerating CRLF line endings and trailing space.
	grep -q '^module github\.com/openchami/fabrica[[:space:]]*$' "$repo/go.mod" || return 0  # the fabrica repo

	printf '%s' "$repo"
}

if [[ -z "${LOCAL_FABRICA+set}" ]]; then
	LOCAL_FABRICA="$(detect_local_fabrica_repo "$FABRICA_BIN")"
fi

# Honor the toolchain used in the notes, but allow overriding.
export GOTOOLCHAIN="${GOTOOLCHAIN:-go1.26.6}"

# --- helpers ----------------------------------------------------------------

run() {
	echo "+ $*"
	"$@"
}

# winpath converts a cygwin/msys path to a native Windows path (forward slashes),
# so arguments handed to the Windows-native fabrica/go binaries resolve
# correctly. On a real POSIX system it is a no-op.
winpath() {
	if command -v cygpath >/dev/null 2>&1; then
		cygpath -m "$1"
	else
		printf '%s' "$1"
	fi
}

# --- pipeline ---------------------------------------------------------------

echo "== generating $SERVICE_NAME into $SERVICE_DIR =="

run rm -rf "$SERVICE_DIR"
run mkdir -p "$OUT_DIR"

# Step 1: initialize the project.
init_args=(init "$SERVICE_NAME"
	--module "$MODULE"
	--group "$GROUP"
	--storage-version v1
	--storage-type ent
	--db "$DB"
	--dir "$(winpath "$OUT_DIR")")
if [[ "$AUTH" == "true" ]]; then
	init_args+=(--auth)
fi
run "$FABRICA_BIN" "${init_args[@]}"

# Optional: build against a local fabrica checkout.
if [[ -n "$LOCAL_FABRICA" ]]; then
	line="replace github.com/openchami/fabrica => $(winpath "$LOCAL_FABRICA")"
	echo "+ append to go.mod: $line"
	printf '\n%s\n' "$line" >>"$SERVICE_DIR/go.mod"
fi

# Steps 2 & 3: `fabrica add resource` plus merge of the annotated structs.
run env -C "$FAB_INIT_DIR" go run . \
	-fabrica "$(winpath "$FABRICA_BIN")" \
	"$(winpath "$STRUCTS_DIR")" \
	"$(winpath "$SERVICE_DIR")"

# Step 4: generate handlers, storage adapters, Ent schema, OpenAPI, etc.
# Its final step (ent client code) fails here because the module's deps are not
# resolved yet; that code is produced by 'go generate ./...' below, so this
# particular failure is expected and non-fatal.
echo "+ env -C $SERVICE_DIR $FABRICA_BIN generate"
if ! env -C "$SERVICE_DIR" "$FABRICA_BIN" generate; then
	echo "note: 'fabrica generate' reported an error (expected: ent client is built by 'go generate' below); continuing"
fi

# Build: generate Ent code first, then resolve deps and compile.
#
# The Ent client packages (internal/storage/ent/...) are produced by
# 'go generate' below, and the generated storage code imports them. Running
# generation first means the single 'go mod tidy' that follows sees a complete
# source tree and resolves the whole import graph cleanly. The generate step
# runs in '-mod=mod' so it may add the Ent (and any other) requirements go.mod
# is still missing at this point, instead of failing read-only resolution.
#
# Previously a 'go mod tidy -e' ran here first. Because the Ent packages did not
# exist yet, 'go mod tidy' tried to resolve the module's own not-yet-generated
# internal/storage/ent/... packages as remote modules and printed alarming but
# harmless "Repository not found" errors (its '-e' flag let the script proceed).
run env -C "$SERVICE_DIR" GOFLAGS=-mod=mod go generate ./...
run env -C "$SERVICE_DIR" go mod tidy
run env -C "$SERVICE_DIR" go build ./...

echo "== done: $SERVICE_DIR =="
echo "run it with:"
echo "  cd $SERVICE_DIR"
echo "  go run ./cmd/server serve --port 8080 --database-url \"file:./${SERVICE_NAME}.db?_fk=1\""
